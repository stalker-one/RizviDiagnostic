PORT=5000
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=12h
CLINIC_NAME=Rizvi Diagnostic Center

# MongoDB Atlas (optional) — leave blank to run on local JSON files only.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DB_NAME=rizvi_diagnostic_center

# Firebase Cloud Messaging server credential.
# Put the complete Firebase service-account JSON on the production backend
# as an environment variable. NEVER commit the JSON key to GitHub.
FIREBASE_SERVICE_ACCOUNT_JSON=
