{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && (cd ../backend && npm install)",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/$1"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
